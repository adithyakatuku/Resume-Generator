{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "workrecord",
  "description": "Where an agent can find evidence of the candidate's work (repos, documents, links).",
  "type": "object",
  "properties": {
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "authors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "git author names or emails that are the candidate"
          },
          "start": {
            "type": "string"
          },
          "end": {
            "type": [
              "string",
              "null"
            ]
          },
          "employer": {
            "type": "string"
          },
          "project": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "about": {
            "type": "string"
          }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "about": {
            "type": "string"
          }
        }
      }
    }
  }
}

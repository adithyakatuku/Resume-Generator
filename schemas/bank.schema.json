{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bank",
  "description": "The candidate's verified facts. Resumes only ever select and lightly reword from here.",
  "type": "object",
  "required": [
    "contact",
    "education",
    "skills"
  ],
  "properties": {
    "contact": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "linkedin": {
          "type": "string"
        },
        "github": {
          "type": "string"
        },
        "portfolio": {
          "type": "string"
        },
        "website": {
          "type": "string"
        },
        "links": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "career_start": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}$",
      "description": "Month professional work began (YYYY-MM); used for years of experience."
